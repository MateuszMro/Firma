
{% extends 'pages/home.html.twig' %}

{% block title %}Rejestracja{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/register.css') }}">
{% endblock %}

{% block content %}

    <section class="register-wrapper">

        <div class="register-container">

            <div class="register-card">

                <div class="register-icon">
                    <span>GM</span>
                </div>

                <h1>Utwórz konto</h1>

                <p class="register-subtitle">
                    Dołącz do nas i korzystaj z możliwości naszego panelu.
                </p>

                {{ form_start(registrationForm, {
                    'attr': {'class': 'register-form'}
                }) }}

                <div class="register-field">
                    {{ form_row(registrationForm.email, {
                        'attr': {
                            'placeholder': 'example@gmail.com',
                            'autofocus': true,
                            'class': 'register-input'
                        },
                        'label': 'Adres e-mail'
                    }) }}
                </div>

                <div class="register-field">
                    {{ form_row(registrationForm.login, {
                        'attr': {
                            'placeholder': 'Twoja nazwa użytkownika',
                            'class': 'register-input'
                        },
                        'label': 'Login'
                    }) }}
                </div>

                <div class="register-field">
                    {{ form_row(registrationForm.plainPassword, {
                        'attr': {
                            'placeholder': 'Wpisz hasło',
                            'class': 'register-input'
                        },
                        'label': 'Hasło'
                    }) }}
                </div>

                <div class="register-field">
                    {{ form_row(registrationForm.confirmPassword, {
                        'attr': {
                            'placeholder': 'Powtórz hasło',
                            'class': 'register-input'
                        },
                        'label': 'Powtórz hasło'
                    }) }}
                </div>

                <div class="register-terms">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                {% if not registrationForm.vars.valid %}
                    <div class="registration-errors">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <div>
                            {{ form_errors(registrationForm) }}
                        </div>
                    </div>
                {% endif %}

                {% for flashMessage in app.flashes('error') %}
                    <div class="register-error">
                        {{ flashMessage }}
                    </div>
                {% endfor %}

                <button type="submit" class="register-button">
                    <i class="fa-solid fa-user-plus"></i>
                    Utwórz konto
                </button>

                {{ form_end(registrationForm) }}

                <div class="register-footer">
                    Masz już konto?
                    <a href="{{ path('app_login') }}">Zaloguj się</a>
                </div>

            </div>

        </div>

    </section>

{% endblock %}

