
{% extends 'pages/home.html.twig' %}

{% block title %}Resetowanie hasła{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/reset-password-success.css') }}">
{% endblock %}

{% block content %}
    <section class="reset-success-page">
        <div class="reset-success-card">

            <div class="success-icon">
                <span>✓</span>
            </div>

            <h1>Sprawdź swoją skrzynkę!</h1>

            <p class="success-description">
                Na podany przez Ciebie adres e-mail wysłaliśmy nowe hasło.
            </p>

            <p class="success-info">
                Nie widzisz e-maila z hasłem? Sprawdź również folder SPAM.
            </p>

            <a href="{{ path('app_login') }}" class="success-button">
                Wróć do logowania
            </a>

            <div class="success-footer">
                <span>Masz problem?</span>
                <a href="mailto:support@mypanel.pl">Skontaktuj się z nami</a>
            </div>

        </div>
    </section>
{% endblock %}
