
{% extends 'pages/home.html.twig' %}

{% block title %}Hasło zostało zmienione{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/change-password-success.css') }}">
{% endblock %}

{% block content %}
    <section class="change-success-page">
        <div class="change-success-card">

            <div class="success-icon">
                <span>✓</span>
            </div>

            <h1>Hasło zostało zmienione!</h1>

            <p class="success-description">
                Twoje hasło zostało pomyślnie zaktualizowane.
                Od teraz możesz logować się do swojego konta przy użyciu nowego hasła.
            </p>

            <div class="success-info">
                <span class="info-icon">🔒</span>
                <span>
                Dla bezpieczeństwa nie udostępniaj swojego hasła innym osobom.
            </span>
            </div>

            <a href="{{ path('homepage') }}" class="success-button">
                Wróć strony głównej
            </a>

            <div class="success-footer">
                <span>Potrzebujesz pomocy?</span>
                <a href="mailto:support@mypanel.pl">Skontaktuj się z nami</a>
            </div>

        </div>
    </section>
{% endblock %}
