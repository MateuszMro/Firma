<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#090a0b">
    <link rel="icon" type="image/png" href="{{ asset('favicon-32.png') }}">

    <title>{% block title %}ZUH Grzegorz Mroczkowski{% endblock %}</title>

    {% block basestylesheets %}
        <link rel="stylesheet" href="{{ asset('css/sidebar.css') }}">
    {% endblock %}

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block basejs %}
        <script type="module" src="{{ asset('js/base.js') }}"></script>
    {% endblock %}

    {% block javascript %}
    {% endblock %}
</head>

<body>
{% block body %}
{% endblock %}

{% block footer %}
{% endblock %}
</body>
</html>
