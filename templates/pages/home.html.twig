{% extends 'base.html.twig' %}

{% block title %}Meble na wymiar Grzegorz Mroczkowski, Sławno{% endblock %}

{% block body %}
    <div class="site-shell">

        <header id="sidebar" class="site-header">
            {% block sidebar %}
                <nav class="navbar" aria-label="Nawigacja główna">

                    <a href="/" class="navbar-brand">
                        <span class="brand-mark">GM</span>
                        <span class="brand-copy">
                    <strong>ZUH</strong>
                    <small>GRZEGORZ MROCZKOWSKI</small>
                </span>
                    </a>

                    <button type="button"
                            class="navbar-toggle"
                            id="navbarToggle"
                            aria-label="Otwórz menu"
                            aria-expanded="false"
                            aria-controls="navbarMobileContent">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <div class="navbar-mobile-content" id="navbarMobileContent">

                        <div class="navbar-menu">
                            <a href="/" class="nav-item">Strona główna</a>
                            <a href="/#o-nas" class="nav-item">O nas</a>
                            <a href="/#oferta"class="nav-item">Oferta</a>
                            <a href="/#kontakt"class="nav-item">Kontakt</a>
                            <a href="/gallery" class="nav-item gallery-nav-link">Galeria</a>
                        </div>

                        <div class="navbar-user">

                            {% if app.user %}

                                <div class="account-dropdown" id="accountDropdown">

                                    <button type="button"
                                            class="account-trigger"
                                            id="accountTrigger"
                                            aria-expanded="false"
                                            aria-controls="accountMenu">

                            <span class="account-avatar">
                                {{ app.user.email|slice(0, 1)|upper }}
                            </span>

                                        <span class="account-info">
                                <strong>{{ app.user.email }}</strong>

                                <small>
                                    {% if is_granted('ROLE_OWNER') %}
                                        Właściciel
                                    {% elseif is_granted('ROLE_ADMIN') %}
                                        Administrator
                                    {% else %}
                                        Użytkownik
                                    {% endif %}
                                </small>
                            </span>

                                        <span class="account-arrow">⌄</span>
                                    </button>

                                    <div class="account-menu" id="accountMenu">

                                        <a href="{{ path('account_index') }}">
                                            <span>◈</span> Moje konto
                                        </a>

                                        <a href="{{ path('app_change_password') }}">
                                            <span>◈</span> Zmień hasło
                                        </a>

                                        {% if is_granted('ROLE_OWNER') %}

                                            <div class="account-menu-divider"></div>

                                            <div class="account-menu-heading">
                                                Panel zarządzania
                                            </div>

                                            <a href="/owner">
                                                <span>⚙</span> Panel właściciela
                                            </a>


                                            <a href="{{ path('admin_messages') }}">
                                                    <span>✉</span> Wiadomości
                                            </a>

                                            <a href="{{ path('admin_stats') }}">
                                                <span>⚙</span> Statystyki odwiedzin
                                            </a>

                                            <a href="{{ path('admin_gallery_admin_panel_gallery') }}">
                                                <span>⚙</span> Zarządzaj galerią
                                            </a>

                                        {% endif %}

                                        <div class="account-menu-divider"></div>

                                        <a href="{{ path('app_logout') }}" class="account-logout">
                                            <span>↗</span> Wyloguj się
                                        </a>

                                    </div>
                                </div>

                            {% endif %}

                        </div>
                    </div>
                </nav>
            {% endblock %}
        </header>


        <main id="content" class="site-content">

            {% block content %}

                    {# =========================SEKCJA GŁÓWNA========================= #}

                    <section class="hero-section">
                        <div class="hero-grid"></div>

                        <div class="hero-inner">
                            <div class="hero-copy">

                                <div class="eyebrow">
                                    <span></span>
                                    ZUH · GRZEGORZ MROCZKOWSKI
                                    <span></span>
                                </div>

                                <h1>
                                    Solidność, której<br>
                                    <em>możesz zaufać.</em>
                                </h1>

                                <p class="hero-lead">
                                    Witamy na stronie ZUH Grzegorz Mroczkowski.
                                    Poznaj naszą działalność, ofertę oraz dotychczasowe realizacje.
                                </p>

                                <div class="hero-actions">
                                    <a href="/gallery" class="button-gold">
                                        Zobacz naszą galerię
                                    </a>

                                    <a href="#kontakt" class="button-quiet">
                                        Skontaktuj się z nami<span>↓</span>
                                    </a>
                                </div>

                            </div>

                            <div class="hero-side">
                                <div class="hero-monogram">
                                    G<span>M</span>
                                </div>

                                <div class="hero-side-line"></div>

                                <div class="hero-side-caption">
                                    PROFESJONALIZM<br>
                                    OD PIERWSZEGO KONTAKTU
                                </div>
                            </div>
                        </div>

                        <div class="hero-bottom">
                            <span>
                                RZETELNOŚĆ <i>·</i>
                                DOŚWIADCZENIE <i>·</i>
                                JAKOŚĆ
                            </span>

                            <a href="#o-nas" class="scroll-note">
                                PRZEWIŃ, ABY ODKRYĆ <b>↓</b>
                            </a>
                        </div>
                    </section>


                    {# =========================O NAS========================= #}

                    <section id="o-nas" class="company-section">

                        <div class="section-kicker">O NAS</div>

                        <div class="intro-grid">

                            <h2>
                                Kim jesteśmy<br>
                                <em>i co nas wyróżnia.</em>
                            </h2>

                            <div class="intro-text">
                                <p>
                                    ZUH Grzegorz Mroczkowski to firma specjalizująca się
                                    w branży meblarskiej.
                                    Stawiamy na profesjonalizm, rzetelność oraz
                                    indywidualne podejście do każdego klienta.
                                </p>

                                <p>
                                    Naszą działalność opieramy na doświadczeniu,
                                    zaangażowaniu i dbałości o jakość wykonywanych usług.
                                    Zależy nam na długotrwałej współpracy i zadowoleniu klientów.
                                </p>
                            </div>

                        </div>

                        <div class="company-features">

                            <div class="feature-item">
                                <span>01</span>
                                <h3>Doświadczenie</h3>
                                <p>
                                    Ponad 20 lat doświadczenia w branży meblarskiej. Specjalizujemy się w
                                    produkcji mebli z drewna m.in. buk, dąb, sosna, świerk, płyty meblowe MDF, laminowane oraz sklejki.
                                </p>
                            </div>

                            <div class="feature-item">
                                <span>02</span>
                                <h3>Rzetelność</h3>
                                <p>
                                    Naszym najważniejszym celem jest zadowolenie klienta, a na ten cel składają się materiały
                                    oraz wykonanie najwyższej jakości w jak najkrótszym czasie.
                                </p>
                            </div>

                            <div class="feature-item">
                                <span>03</span>
                                <h3>Jakość</h3>
                                <p>
                                    [Opisz standard wykonywanych usług.]
                                </p>
                            </div>

                        </div>

                    </section>


                    {# =========================OFERTA========================= #}

                    <section id="oferta" class="company-section offer-section">

                        <div class="section-kicker">OFERTA</div>

                        <h2>
                            Co możemy<br>
                            <em>dla Ciebie zrobić.</em>
                        </h2>

                        <p class="section-intro">
                            Zapoznaj się z naszą ofertą. Chętnie pomożemy
                            dobrać rozwiązanie dopasowane do Twoich potrzeb.
                        </p>

                        <div class="offer-grid">

                            <div class="offer-card">
                                <span class="offer-number">01</span>
                                <h3>Kuchnie na wymiar</h3>
                                <p>
                                    Przy wyborze naszych mebli zapewniamy wszystkie pomiary oraz projekt
                                    tworzony w profesjonalnym programie.
                                </p>
                            </div>

                            <div class="offer-card">
                                <span class="offer-number">02</span>
                                <h3>Wyposażenie salonu</h3>
                                <p>
                                    Zajmujemy się również projektowaniem oraz realizacją wposażenia salonu tj.
                                    witryny, komody, stoły, szafki TV, konsole czy toaletki.
                                </p>
                            </div>

                            <div class="offer-card">
                                <span class="offer-number">03</span>
                                <h3>Meble dla dzieci</h3>
                                <p>
                                    Biurka, szafki, komody, łóżeczka, łóżka, łóżka piętrowe z aranżacją dołu.
                                </p>
                            </div>

                            <div class="offer-card">
                                <span class="offer-number">04</span>
                                <h3>Elementy meblowe</h3>
                                <p>
                                    Elementy meblowe surowe, lakierowane, wiercone, frezowane oklejane ABS oraz olejowane.
                                </p>
                            </div>

                            <div class="offer-card">
                                <span class="offer-number">05</span>
                                <h3>Meble seryjne</h3>
                                <p>
                                    Wyposażenie biur, akademików czy hoteli.
                                </p>
                            </div>

                            <div class="offer-card">
                                <span class="offer-number">06</span>
                                <h3>Projekty</h3>
                                <p>
                                    Projektowanie oraz aranżacja wnętrz, które są robione w profesjonalnym programie.
                                </p>
                            </div>

                        </div>

                        <div class="offer-footer">
                            <p>Nie znalazłeś tego, czego szukasz?</p>
                            <a href="#kontakt" class="button-gold">
                                Zapytaj o ofertę <span>↓</span>
                            </a>
                        </div>

                    </section>


                    {# =========================KONTAKT========================= #}

                    <section id="kontakt" class="company-section contact-section">

                        <div class="section-kicker">KONTAKT</div>

                        <h2>
                            Skontaktuj się<br>
                            <em>z nami.</em>
                        </h2>

                        <p class="section-intro">
                            Masz pytania, potrzebujesz wyceny lub chcesz rozpocząć
                            współpracę? Zapraszamy do kontaktu.
                        </p>

                        <div class="contact-grid">

                            <div class="contact-item">
                                <span>TELEFON</span>
                                <h3>[Numer telefonu]</h3>
                                <p>[Godziny dostępności]</p>
                            </div>

                            <div class="contact-item">
                                <span>E-MAIL</span>
                                <h3>[Adres e-mail]</h3>
                                <p>Napisz do nas – odpowiemy na wiadomość.</p>
                            </div>

                            <div class="contact-item">
                                <span>ADRES</span>
                                <h3>[Ulica i numer]</h3>
                                <p>[Kod pocztowy i miejscowość]</p>
                            </div>

                        </div>

                        {% for message in app.flashes('success') %}
                            <div class="success-modal" id="successModal">
                                <div class="success-modal-content">
                                    <div class="success-icon">✓</div>
                                    <h2>Wiadomość wysłana!</h2>
                                    <p>{{ message }}</p>
                                    <button type="button" onclick="closeSuccessModal()">
                                        Zamknij
                                    </button>
                                </div>
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <div class="contact-form-wrapper">

                            <div class="contact-form-heading">
                                <span class="section-kicker">FORMULARZ KONTAKTOWY</span>
                                <h3>Napisz <em>do nas.</em></h3>
                                <p>
                                    Wypełnij formularz, a skontaktujemy się z Tobą
                                    w sprawie Twojego zapytania.
                                </p>
                            </div>

                            <form class="contact-form" action="{{ path('contact_send') }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">

                                <div class="contact-form-row">

                                    <div class="contact-form-field">
                                        <label for="contact-name">Imię i nazwisko</label>
                                        <input
                                            type="text"
                                            id="contact-name"
                                            name="name"
                                            placeholder="Wpisz imię i nazwisko"
                                            required
                                        >
                                    </div>

                                    <div class="contact-form-field">
                                        <label for="contact-phone">Numer telefonu</label>
                                        <input
                                            type="tel"
                                            id="contact-phone"
                                            inputmode="numeric"
                                            name="phone"
                                            placeholder="Wpisz numer telefonu"
                                            required
                                        >
                                    </div>

                                    <div class="contact-form-field">
                                        <label for="contact-email">E-mail</label>
                                        <input
                                            type="email"
                                            id="contact-email"
                                            name="email"
                                            placeholder="Wpisz adres e-mail"
                                            required
                                        >
                                    </div>

                                </div>

                                <div class="contact-form-field">
                                    <label for="contact-message">Wiadomość</label>
                                    <textarea
                                        id="contact-message"
                                        name="message"
                                        rows="6"
                                        placeholder="Napisz, w czym możemy Ci pomóc..."
                                        required
                                    ></textarea>
                                </div>

                                <button type="submit" class="contact-form-submit">
                                    Wyślij wiadomość <span>→</span>
                                </button>

                            </form>

                        </div>

                    </section>

            {% endblock %}

        </main>
    </div>
    <div id="cookie-banner" class="cookie-banner" style="display: none;">
        <div class="cookie-banner-content">
            <div>
                <strong>Informacja o plikach cookies</strong>
                <p>
                    Nasza strona wykorzystuje niezbędne pliki cookies,
                    które zapewniają jej prawidłowe działanie.
                    Więcej informacji znajdziesz w
                    <a href="{{ path('app_privacy_policy') }}">Polityce prywatności</a>.
                </p>
            </div>

            <button type="button" id="cookie-accept" class="cookie-accept">
                Rozumiem
            </button>
        </div>
    </div>


    <script>

            document.addEventListener('DOMContentLoaded', function () {
            const banner = document.getElementById('cookie-banner');
            const acceptButton = document.getElementById('cookie-accept');

            if (!banner || !acceptButton) return;

            if (!localStorage.getItem('cookies-accepted')) {
            banner.style.display = 'block';
        }

            acceptButton.addEventListener('click', function () {
            localStorage.setItem('cookies-accepted', 'true');
            banner.style.display = 'none';
        });
        });

        document.addEventListener('DOMContentLoaded', function () {

            const navbarToggle = document.getElementById('navbarToggle');
            const navbarContent = document.getElementById('navbarMobileContent');

            function closeMobileMenu() {
                if (!navbarToggle || !navbarContent) return;

                navbarContent.classList.remove('mobile-open');
                navbarToggle.classList.remove('active');
                navbarToggle.setAttribute('aria-expanded', 'false');
                navbarToggle.setAttribute('aria-label', 'Otwórz menu');
            }

            if (navbarToggle && navbarContent) {

                navbarToggle.addEventListener('click', function () {

                    const isOpen = navbarContent.classList.toggle('mobile-open');

                    navbarToggle.classList.toggle('active', isOpen);

                    navbarToggle.setAttribute(
                        'aria-expanded',
                        isOpen ? 'true' : 'false'
                    );

                    navbarToggle.setAttribute(
                        'aria-label',
                        isOpen ? 'Zamknij menu' : 'Otwórz menu'
                    );
                });

                navbarContent.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', closeMobileMenu);
                });
            }


            const dropdown = document.getElementById('accountDropdown');
            const trigger = document.getElementById('accountTrigger');

            function closeAccountMenu() {
                if (!dropdown || !trigger) return;

                dropdown.classList.remove('is-open');
                trigger.setAttribute('aria-expanded', 'false');
            }

            if (dropdown && trigger) {

                trigger.addEventListener('click', function (event) {

                    event.stopPropagation();

                    const isOpen = dropdown.classList.toggle('is-open');

                    trigger.setAttribute(
                        'aria-expanded',
                        isOpen ? 'true' : 'false'
                    );
                });

                document.addEventListener('click', function (event) {
                    if (!dropdown.contains(event.target)) {
                        closeAccountMenu();
                    }
                });
            }


            document.addEventListener('keydown', function (event) {

                if (event.key === 'Escape') {
                    closeMobileMenu();
                    closeAccountMenu();
                }

            });

        });
            function closeSuccessModal() {
                const modal = document.getElementById('successModal');

                if (modal) {
                    modal.style.display = 'none';
                }
            }
    </script>

{% endblock %}


