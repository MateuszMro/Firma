{% extends 'pages/home.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/gallery.css') }}">
{% endblock %}

{% block content %}
    <div class="gallery-page">

{#        <div id="gallery-loader" class="gallery-loader">#}
{#            <div class="gallery-loader-spinner"></div>#}
{#            <p>Wczytywanie galerii...</p>#}
{#        </div>#}

        <div class="gallery-heading">
            <div>
                <h1>Galeria</h1>
                <p>Zobacz nasze projekty oraz realizacje.</p>
            </div>

            {% if is_granted('ROLE_OWNER') %}
                <a href="{{ path('admin_gallery_add') }}" class="gallery-add-button">
                    + Dodaj zdjęcia
                </a>
            {% endif %}
        </div>

        <div class="gallery-filters">
            <a href="{{ path('app_gallery') }}"
               class="gallery-filter {{ selectedCategory is null ? 'active' : '' }}">
                Wszystkie
            </a>

            {% for category in categories %}
                <a href="{{ path('app_gallery', {category: category.id}) }}"
                   class="gallery-filter {{ selectedCategory and selectedCategory.id == category.id ? 'active' : '' }}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>

        <div class="gallery-grid">
            {% for session in sessions %}
                <a href="{{ path('app_gallery_show', {id: session.id}) }}"
                   class="gallery-card">

                    {% if session.images|length > 0 %}
                        <img
                            src="{{ asset('uploads/gallery/' ~ session.images|first.filename) }}"
                            alt="{{ session.title }}"
                            loading="lazy"
                        >
                    {% else %}
                        <div class="gallery-no-image">Brak zdjęcia</div>
                    {% endif %}

                    <div class="gallery-card-info">
                        <h3>{{ session.title }}</h3>

                        <p>
                            {{ session.description|striptags|slice(0, 110) }}{% if session.description|striptags|length > 110 %}...{% endif %}
                        </p>

                        <span>
                            {{ session.images|length }} zdjęć
                        </span>

                        <div class="add-date">
                            Dodano {{ session.createdAt|date('d.m.Y') }}
                        </div>
                    </div>
                </a>
            {% else %}
                {% if selectedCategory %}
                    <p>Brak sesji w kategorii „{{ selectedCategory.name }}”.</p>
                {% else %}
                    <p>Galeria jest jeszcze pusta.</p>
                {% endif %}
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
            <nav class="gallery-pagination" aria-label="Nawigacja stron galerii">

                {# Poprzednia strona #}
                {% if currentPage > 1 %}
                    <a href="{{ path('app_gallery', {page: currentPage - 1, category: selectedCategoryId}) }}"
                       class="gallery-page-arrow"
                       aria-label="Poprzednia strona">
                        <span aria-hidden="true">‹</span>
                    </a>
                {% else %}
                    <span class="gallery-page-arrow disabled" aria-label="Poprzednia strona">
                <span aria-hidden="true">‹</span>
            </span>
                {% endif %}

                {# Pierwsza strona #}
                {% if paginationPages|first > 1 %}
                    <a href="{{ path('app_gallery', {page: 1, category: selectedCategoryId}) }}"
                       class="gallery-page-number">1</a>

                    {% if paginationPages|first > 2 %}
                        <span class="gallery-page-dots">...</span>
                    {% endif %}
                {% endif %}

                {# Numery stron #}
                {% for page in paginationPages %}
                    <a href="{{ path('app_gallery', {page: page, category: selectedCategoryId}) }}"
                       class="gallery-page-number {{ page == currentPage ? 'active' : '' }}"
                       {% if page == currentPage %}aria-current="page"{% endif %}>
                        {{ page }}
                    </a>
                {% endfor %}

                {# Ostatnia strona #}
                {% if paginationPages|last < totalPages %}
                    {% if paginationPages|last < totalPages - 1 %}
                        <span class="gallery-page-dots">...</span>
                    {% endif %}

                    <a href="{{ path('app_gallery', {page: totalPages, category: selectedCategoryId}) }}"
                       class="gallery-page-number">
                        {{ totalPages }}
                    </a>
                {% endif %}

                {# Następna strona #}
                {% if currentPage < totalPages %}
                    <a href="{{ path('app_gallery', {page: currentPage + 1, category: selectedCategoryId}) }}"
                       class="gallery-page-arrow"
                       aria-label="Następna strona">
                        <span aria-hidden="true">›</span>
                    </a>
                {% else %}
                    <span class="gallery-page-arrow disabled" aria-label="Następna strona">
                <span aria-hidden="true">›</span>
            </span>
                {% endif %}

            </nav>

            <div class="gallery-pagination-info">
                Strona {{ currentPage }} z {{ totalPages }}
                <span>·</span>
                Łącznie {{ totalSessions }} sesji
            </div>
        {% endif %}

    </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const loader = document.getElementById('gallery-loader');

            if (!loader) {
                return;
            }

            const loaderText = loader.querySelector('p');

            function showLoader(link) {
                if (link.classList.contains('gallery-card')) {
                    loaderText.textContent = 'Wczytywanie zdjęć...';
                } else {
                    loaderText.textContent = 'Wczytywanie galerii...';
                }

                loader.classList.add('active');
            }

            function handleLink(event) {
                const link = event.target.closest(
                    '.gallery-filter, .gallery-pagination a'
                );

                if (!link) {
                    return;
                }

                if (
                    event.ctrlKey ||
                    event.metaKey ||
                    event.shiftKey ||
                    event.altKey
                ) {
                    return;
                }

                showLoader(link);
            }

            document.addEventListener('click', handleLink);

        });

        window.addEventListener('pageshow', function () {
            const loader = document.getElementById('gallery-loader');

            if (loader) {
                loader.classList.remove('active');
            }
        });

        window.addEventListener('load', function () {
            const loader = document.getElementById('gallery-loader');

            if (loader) {
                loader.classList.remove('active');
            }
        });
    </script>
{% endblock %}
