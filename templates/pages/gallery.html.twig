{% extends 'pages/home.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/gallery.css') }}">
{% endblock %}

{% block content %}
    <div class="gallery-page">

{#        <div id="gallery-loader" class="gallery-loader">#}
{#            <div class="gallery-loader-spinner"></div>#}
{#            <p>Wczytywanie galerii...</p>#}
{#        </div>#}

        <div class="gallery-heading">
            <div>
                <h1>Galeria</h1>
                <p>Zobacz nasze projekty oraz realizacje.</p>
            </div>

            {% if is_granted('ROLE_OWNER') %}
                <a href="{{ path('admin_gallery_add') }}" class="gallery-add-button">
                    + Dodaj zdjęcia
                </a>
            {% endif %}
        </div>

        <div class="gallery-filters">
            <a href="{{ path('app_gallery') }}"
               class="gallery-filter {{ selectedCategory is null ? 'active' : '' }}">
                Wszystkie
            </a>

            {% for category in categories %}
                <a href="{{ path('app_gallery', {category: category.id}) }}"
                   class="gallery-filter {{ selectedCategory and selectedCategory.id == category.id ? 'active' : '' }}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>

        <div id="gallery-results">
            {% include 'pages/gallery_results.html.twig' %}
        </div>



    </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const results = document.getElementById('gallery-results');

            if (!results) {
                return;
            }

            let controller = null;

            function updateActiveFilter(url) {
                const selectedCategory = new URL(url, window.location.origin)
                    .searchParams.get('category') || '';

                document.querySelectorAll('.gallery-filter').forEach(function (link) {
                    const linkCategory = new URL(link.href, window.location.origin)
                        .searchParams.get('category') || '';

                    link.classList.toggle('active', linkCategory === selectedCategory);
                });
            }

            function updateResults(html) {
                const template = document.createElement('template');
                template.innerHTML = html;

                const incomingGrid = template.content.querySelector('.gallery-grid');
                const currentGrid = results.querySelector('.gallery-grid');

                if (!incomingGrid || !currentGrid) {
                    throw new Error('Nie znaleziono siatki galerii.');
                }

                // Zapamiętujemy obecne kafelki według ID sesji.
                const existingCards = new Map();

                currentGrid.querySelectorAll('.gallery-card[data-session-id]')
                    .forEach(function (card) {
                        existingCards.set(card.dataset.sessionId, card);
                    });

                // Przygotowujemy listę docelową, zachowując wspólne kafelki.
                const newChildren = Array.from(incomingGrid.children).map(function (item) {
                    const id = item.dataset.sessionId;

                    if (id && existingCards.has(id)) {
                        return existingCards.get(id);
                    }

                    return item;
                });

                // Wstawiamy nowe kafelki i zachowujemy istniejące elementy DOM.
                newChildren.forEach(function (item, index) {
                    const currentItem = currentGrid.children[index];

                    if (currentItem !== item) {
                        currentGrid.insertBefore(item, currentItem || null);
                    }
                });

                // Usuwamy kafelki, których nie ma w nowej kategorii.
                while (currentGrid.children.length > newChildren.length) {
                    currentGrid.lastElementChild.remove();
                }

                // Aktualizujemy paginację i informację o liczbie sesji.
                [
                    '.gallery-pagination',
                    '.gallery-pagination-info'
                ].forEach(function (selector) {
                    const current = results.querySelector(selector);
                    const incoming = template.content.querySelector(selector);

                    if (current && incoming) {
                        current.replaceWith(incoming);
                    } else if (current) {
                        current.remove();
                    } else if (incoming) {
                        results.appendChild(incoming);
                    }
                });
            }

            async function loadGallery(url, updateHistory = true) {
                if (controller) {
                    controller.abort();
                }

                controller = new AbortController();

                try {
                    const response = await fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: controller.signal
                    });

                    if (!response.ok) {
                        throw new Error('Nie udało się pobrać galerii.');
                    }

                    const html = await response.text();

                    updateResults(html);
                    updateActiveFilter(url);
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });


                    if (updateHistory) {
                        history.pushState({}, '', url);
                    }

                } catch (error) {
                    if (error.name !== 'AbortError') {
                        window.location.href = url;
                    }
                }
            }

            document.addEventListener('click', function (event) {
                const link = event.target.closest(
                    '.gallery-filter, .gallery-pagination a'
                );

                if (!link) {
                    return;
                }

                if (
                    event.ctrlKey ||
                    event.metaKey ||
                    event.shiftKey ||
                    event.altKey ||
                    event.button !== 0
                ) {
                    return;
                }

                event.preventDefault();

                loadGallery(link.href);
            });

            window.addEventListener('popstate', function () {
                loadGallery(window.location.href, false);
            });
        });
    </script>
{% endblock %}
