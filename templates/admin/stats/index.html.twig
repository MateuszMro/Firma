
{% extends 'pages/home.html.twig' %}

{% block title %}Statystyki strony{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/stats.css') }}">
{% endblock %}

{% block content %}

    <div class="stats-page">

        <div class="stats-header">
            <div class="stats-logo">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="32" height="32"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 3v18h18"/>
                    <rect x="6" y="12" width="3" height="6" rx="1"/>
                    <rect x="11" y="8" width="3" height="10" rx="1"/>
                    <rect x="16" y="4" width="3" height="14" rx="1"/>
                </svg>
            </div>

            <div class="stats-heading">
                <span class="stats-eyebrow">PANEL WŁAŚCICIELA</span>
                <h1>Statystyki strony</h1>
                <p>Monitoruj ruch i aktywność odwiedzających Twoją stronę.</p>
            </div>
        </div>

        <div class="stats-cards">

            <div class="stats-card">
                <div class="stats-card-top">

                    <span class="stats-card-label">ŁĄCZNIE</span>
                </div>

                <span class="stats-card-title">Wszystkie wejścia</span>
                <strong>{{ totalVisits }}</strong>
                <p>Całkowita liczba odwiedzin strony</p>
            </div>

            <div class="stats-card">
                <div class="stats-card-top">

                    <span class="stats-card-label">UŻYTKOWNICY</span>
                </div>

                <span class="stats-card-title">Unikalni odwiedzający</span>
                <strong>{{ uniqueVisitors }}</strong>
                <p>Liczba rozpoznanych odwiedzających</p>
            </div>

            <div class="stats-card">
                <div class="stats-card-top">

                    <span class="stats-card-label">DZISIAJ</span>
                </div>

                <span class="stats-card-title">Odwiedziny dzisiaj</span>
                <strong>{{ todayVisits }}</strong>
                <p>Liczba wejść w bieżącym dniu</p>
            </div>

        </div>

        <div class="stats-week">

            <div class="stats-section-heading">


                <div>
                    <h2>Odwiedziny w tym tygodniu</h2>
                    <p>Aktywność odwiedzających w poszczególnych dniach</p>
                </div>
            </div>

            <div class="weekly-chart">

                {% set maxVisits = 1 %}
                {% for day in weeklyStats %}
                    {% set maxVisits = max(maxVisits, day.visits) %}
                {% endfor %}

                {% for day in weeklyStats %}
                    <div class="chart-column">

                        <strong class="chart-value">{{ day.visits }}</strong>

                        <div class="chart-bar-wrapper">
                            <div
                                class="chart-bar"
                                style="height: {{ day.visits / maxVisits * 100 }}%;"
                            ></div>
                        </div>

                        <span class="chart-day">{{ day.day }}</span>

                    </div>
                {% endfor %}

            </div>

        </div>

        <div class="stats-back-wrapper">
            <a href="/" class="stats-back">
                <i class="fa-solid fa-arrow-left"></i>
                Wróć do strony głównej
            </a>
        </div>

    </div>

{% endblock %}
