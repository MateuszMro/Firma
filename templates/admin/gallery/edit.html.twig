
{% extends 'pages/home.html.twig' %}

{% block title %}Edytuj zdjęcia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gallery.css') }}">
{% endblock %}

{% block content %}

    <div class="admin-gallery-page">

        <a href="{{ path('admin_gallery_admin_panel_gallery') }}" class="gallery-back">
            <i class="fa-solid fa-arrow-left"></i>
            ← Wróć do zarządzania galerią
        </a>

        <div class="admin-gallery-heading">
            <span class="admin-gallery-eyebrow">PANEL ZARZĄDZANIA</span>
            <h1>Edytuj zdjęcia</h1>
            <p>Zarządzaj tytułem, opisem i zdjęciami wybranej sesji.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="gallery-success">
                <i class="fa-solid fa-circle-check"></i>
                {{ message }}
            </div>
        {% endfor %}

        <section class="admin-gallery-form-section">

            <div class="admin-section-heading">
                <div>
                    <h2>Informacje o sesji</h2>
                    <p>Edytuj dane i dodaj nowe fotografie.</p>
                </div>
            </div>

            <div class="admin-gallery-form">

                {{ form_start(form, {
                    attr: {
                        id: 'gallery-edit-form',
                        class: 'admin-gallery-edit-form',
                        enctype: 'multipart/form-data'
                    }
                }) }}

                <div class="form-field">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="form-field">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="form-field">
                    {{ form_label(form.images) }}
                    {{ form_widget(form.images) }}
                    {{ form_errors(form.images) }}

                    <small>
                        Możesz dodać kolejne zdjęcia. Dotychczasowe fotografie pozostaną w galerii.
                    </small>
                </div>

                <div class="form-field gallery-categories-field">
                    {{ form_label(form.categories) }}
                    {{ form_widget(form.categories) }}
                    {{ form_errors(form.categories) }}
                </div>

                <div id="gallery-edit-loader" class="gallery-loader">
                    <div class="gallery-loader-spinner"></div>
                    <p>Zapisywanie zmian...</p>
                </div>

                <button type="submit" class="gallery-submit-button">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Zapisz zmiany
                </button>

                {{ form_end(form) }}

            </div>

        </section>

        <section class="admin-current-images">

            <div class="admin-section-heading">
                <div>
                    <h2>Zdjęcia w tej sesji</h2>
                    <p>Aktualne fotografie zapisane w galerii.</p>
                </div>

                <span class="admin-image-count">
                {{ session.images|length }} zdjęć
            </span>
            </div>

            <div class="admin-photos-grid">

                {% for photo in session.images %}
                    <div class="admin-photo-card">

                        <div class="admin-photo-preview">
                            <img
                                src="{{ asset('uploads/gallery/' ~ photo.filename) }}"
                                alt="{{ session.title }}"
                                loading="lazy"
                            >
                        </div>

                        <div class="admin-photo-actions">
                            <form
                                method="post"
                                action="{{ path('admin_gallery_image_delete', {id: photo.id}) }}"
                                onsubmit="return confirm('Czy na pewno usunąć to zdjęcie?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_image_' ~ photo.id) }}"
                                >

                                <button type="submit" class="gallery-delete-button">
                                    <i class="fa-solid fa-trash-can"></i>
                                    Usuń zdjęcie
                                </button>
                            </form>
                        </div>

                    </div>
                {% else %}
                    <div class="admin-gallery-empty">
                        <i class="fa-regular fa-images"></i>
                        <p>Ta sesja nie ma jeszcze zdjęć.</p>
                    </div>
                {% endfor %}

            </div>

        </section>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('gallery-edit-form');
            const loader = document.getElementById('gallery-edit-loader');

            if (!form || !loader) return;

            form.addEventListener('submit', function () {
                if (!form.checkValidity()) return;

                loader.classList.add('active');

                const button = form.querySelector('button[type="submit"]');

                if (button) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Zapisywanie zmian...';
                }
            });
        });
    </script>
{% endblock %}
