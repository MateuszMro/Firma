
{% extends 'pages/home.html.twig' %}

{% block title %}Zarządzanie galerią{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gallery.css') }}">
{% endblock %}

{% block content %}
    <div class="admin-gallery-page admin-gallery-panel">

        <div class="admin-gallery-heading">
            <div>
                <span class="admin-gallery-eyebrow">PANEL ADMINISTRACYJNY</span>
                <h1>Zarządzanie galerią</h1>
                <p>Dodawaj, edytuj i usuwaj sesje zdjęciowe.</p>
            </div>

            <a href="{{ path('admin_gallery_add') }}" class="gallery-add-button">
                <i class="fa-solid fa-plus"></i>
                Dodaj zdjęcia
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="gallery-success">
                <i class="fa-solid fa-circle-check"></i>
                {{ message }}
            </div>
        {% endfor %}

        <div class="admin-gallery-panel-info">
            <div>
                <h2>Twoje sesje zdjęciowe</h2>
                <p>Zarządzaj zdjęciami znajdującymi się w galerii.</p>
            </div>

            <span class="admin-image-count">
            {{ sessions|length }} sesji
        </span>
        </div>

        <div class="gallery-grid">
            {% for session in sessions %}
                <div class="gallery-card">

                    {% if session.images|length > 0 %}
                        <div class="admin-panel-gallery-image">
                            <img
                                src="{{ asset('uploads/gallery/' ~ session.images|first.filename) }}"
                                alt="{{ session.title }}"
                            >
                            <span class="admin-panel-photo-count">
                            <i class="fa-regular fa-images"></i>
                            {{ session.images|length }} zdjęć
                        </span>
                        </div>
                    {% else %}
                        <div class="gallery-no-image">
                            <i class="fa-regular fa-image"></i>
                            <span>Brak zdjęcia</span>
                        </div>
                    {% endif %}

                    <div class="gallery-card-info">
                        <h3>{{ session.title }}</h3>

                        <p>
                            {{ session.description|striptags|slice(0, 100) }}
                            {% if session.description|striptags|length > 100 %}...{% endif %}
                        </p>

                        <div class="gallery-admin-actions">
                            <a href="{{ path('admin_gallery_edit', {id: session.id}) }}"
                               class="gallery-edit-button">
                                <i class="fa-solid fa-pen-to-square"></i>
                                Edytuj
                            </a>

                            <form method="post"
                                  action="{{ path('admin_gallery_delete', {id: session.id}) }}"
                                  onsubmit="return confirm('Czy na pewno usunąć całą sesję?');">

                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('delete_session_' ~ session.id) }}">

                                <button type="submit" class="gallery-delete-button">
                                    <i class="fa-solid fa-trash-can"></i>
                                    Usuń całość
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            {% else %}
                <div class="admin-gallery-empty">
                    <i class="fa-regular fa-images"></i>
                    <p>Nie ma jeszcze żadnych sesji zdjęciowych.</p>
                    <span>Dodaj pierwszą sesję, aby rozpocząć tworzenie galerii.</span>
                </div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
