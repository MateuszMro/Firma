
{% extends 'pages/home.html.twig' %}

{% block title %}Dodaj zdjęcia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gallery.css') }}">
{% endblock %}

{% block content %}
    <div class="admin-gallery-page admin-gallery-add-page">

        <a href="{{ path('admin_gallery_admin_panel_gallery') }}" class="gallery-back">
            <i class="fa-solid fa-arrow-left"></i>
            ← Wróć do zarządzania galerią
        </a>

        <div class="admin-gallery-heading">
            <div>
                <span class="admin-gallery-eyebrow">PANEL ADMINISTRACYJNY</span>
                <h1>Dodaj zdjęcia</h1>
                <p>Utwórz nową sesję i dodaj do niej zdjęcia.</p>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="gallery-success">
                <i class="fa-solid fa-circle-check"></i>
                {{ message }}
            </div>
        {% endfor %}

        <section class="admin-gallery-form-section admin-gallery-add-section">

            <div class="admin-section-heading">
                <div>
                    <h2>Nowa sesja zdjęciowa</h2>
                    <p>Uzupełnij informacje i wybierz zdjęcia do galerii.</p>
                </div>

            </div>

            {{ form_start(form, {
                attr: {
                    id: 'gallery-add-form',
                    class: 'admin-gallery-edit-form',
                    enctype: 'multipart/form-data'
                }
            }) }}

            <div class="form-field">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="form-field">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-field admin-gallery-file-field">
                {{ form_label(form.images) }}
                {{ form_widget(form.images) }}
                {{ form_errors(form.images) }}
                <small>
                    Możesz zaznaczyć kilka zdjęć jednocześnie.
                    Dozwolone formaty: JPG, PNG lub WEBP.
                    Maksymalny rozmiar jednego zdjęcia: 8 MB.
                </small>
            </div>

            <div class="form-field gallery-categories-field">
                {{ form_label(form.categories) }}
                {{ form_widget(form.categories) }}
                {{ form_errors(form.categories) }}
            </div>

            <div id="gallery-add-loader" class="gallery-loader">
                <div class="gallery-loader-spinner"></div>
                <p>Dodawanie sesji i przesyłanie zdjęć...</p>
            </div>

            <div class="admin-gallery-add-actions">
                <button type="submit" class="gallery-submit-button">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Zapisz sesję
                </button>
            </div>

            {{ form_end(form) }}

        </section>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('gallery-add-form');
            const loader = document.getElementById('gallery-add-loader');

            if (!form || !loader) return;

            form.addEventListener('submit', function () {
                if (!form.checkValidity()) return;

                loader.classList.add('active');

                const button = form.querySelector('button[type="submit"]');

                if (button) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Dodawanie sesji...';
                }
            });
        });
    </script>
{% endblock %}
