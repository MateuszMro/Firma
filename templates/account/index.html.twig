
{% extends 'pages/home.html.twig' %}

{% block title %}Moje konto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/account.css') }}">
{% endblock %}

{% block content %}

    <div class="account-container">

        <div class="account-heading">
            <div class="account-icon">
                <span>GM</span>
            </div>

            <div>
                <span class="account-eyebrow">PANEL UŻYTKOWNIKA</span>
                <h1>Moje konto</h1>
                <p>Zarządzaj swoimi danymi i ustawieniami konta.</p>
            </div>
        </div>

        {% for message in app.flashes('danger') %}
            <div class="account-alert danger">
                <i class="fa-solid fa-circle-exclamation"></i>
                {{ message }}
            </div>
        {% endfor %}

        <section class="account-card">

            <div class="account-card-heading">

                <div>
                    <h2>Dane użytkownika</h2>
                    <p>Informacje przypisane do Twojego konta.</p>
                </div>
            </div>

            <div class="account-details">

                <div class="account-row">
                    <span><i class="fa-solid fa-user-tag"></i> Login</span>
                    <strong>{{ account.login ?? 'Nie podano' }}</strong>
                </div>

                <div class="account-row">
                    <span><i class="fa-solid fa-envelope"></i> Adres e-mail</span>
                    <strong>{{ account.email }}</strong>
                </div>

                <div class="account-row">
                    <span><i class="fa-solid fa-lock"></i> Hasło</span>
                    <strong>••••••••</strong>
                </div>

                <div class="account-row">
                    <span><i class="fa-solid fa-calendar-days"></i> Data utworzenia konta</span>
                    <strong>
                        {% if account.createdDate %}
                            {{ account.createdDate|date('d.m.Y') }}
                        {% else %}
                            Brak danych
                        {% endif %}
                    </strong>
                </div>

                <div class="account-row">
                    <span><i class="fa-solid fa-shield-halved"></i> Przypisana rola</span>
                    <strong>
                        {% if 'ROLE_OWNER' in account.roles %}
                            Właściciel
                        {% elseif 'ROLE_ADMIN' in account.roles %}
                            Administrator
                        {% else %}
                            Użytkownik
                        {% endif %}
                    </strong>
                </div>

            </div>

            <a href="/change-password" class="account-password-link">
                <i class="fa-solid fa-key"></i>
                Zmień hasło
                <i class="fa-solid fa-arrow-right account-link-arrow"></i>
            </a>

        </section>

        <section class="account-card danger-card">

            <div class="account-card-heading">


                <div>
                    <h2>Usuwanie konta</h2>
                    <p>Ta operacja jest nieodwracalna.</p>
                </div>
            </div>

            <p class="danger-description">
                Usunięcie konta spowoduje trwałe usunięcie Twojego konta z serwisu.
                Przed wykonaniem tej operacji wymagane jest potwierdzenie aktualnym hasłem.
            </p>

            <form method="post"
                  action="{{ path('account_index') }}"
                  onsubmit="return confirm('Czy na pewno chcesz trwale usunąć swoje konto?');">

                <input type="hidden" name="_token"
                       value="{{ csrf_token('delete_account') }}">

                <label for="delete-password">
                    Potwierdź aktualnym hasłem:
                </label>

                <input
                    type="password"
                    id="delete-password"
                    name="password"
                    placeholder="Wpisz swoje aktualne hasło"
                    required
                    autocomplete="current-password"
                >

                <button type="submit" class="delete-account-button">
                    <i class="fa-solid fa-trash-can"></i>
                    Usuń moje konto
                </button>

            </form>

        </section>

    </div>

{% endblock %}
