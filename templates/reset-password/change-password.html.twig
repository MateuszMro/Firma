
{% extends 'pages/home.html.twig' %}

{% block title %}Zmiana hasła{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/change-password.css') }}">
{% endblock %}

{% block content %}
    <section class="password-wrapper">

        <div class="password-card">

            <div class="password-icon">
                <span>GM</span>
            </div>

            <div class="password-heading">
                <span class="password-eyebrow">PANEL UŻYTKOWNIKA</span>
                <h1>Zmiana hasła</h1>
                <p class="password-subtitle">
                    Zadbaj o bezpieczeństwo swojego konta.
                    Ustaw nowe, bezpieczne hasło.
                </p>
            </div>

            {{ form_start(changePasswordForm, {
                'attr': {'class': 'password-form'}
            }) }}

            <div class="password-field">
                {{ form_row(changePasswordForm.plainPassword, {
                    'attr': {
                        'autofocus': true,
                        'placeholder': 'Wprowadź obecne hasło',
                        'class': 'password-input',
                        'autocomplete': 'current-password'
                    }
                }) }}
            </div>

            <div class="password-field">
                {{ form_row(changePasswordForm.confirmPassword, {
                    'attr': {
                        'placeholder': 'Wprowadź nowe hasło',
                        'class': 'password-input',
                        'autocomplete': 'new-password'
                    }
                }) }}
            </div>

            <div class="password-field">
                {{ form_row(changePasswordForm.confirmNewPassword, {
                    'attr': {
                        'placeholder': 'Powtórz nowe hasło',
                        'class': 'password-input',
                        'autocomplete': 'new-password'
                    }
                }) }}
            </div>

            {% if not changePasswordForm.vars.valid %}
                <div class="password-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div>{{ form_errors(changePasswordForm) }}</div>
                </div>
            {% endif %}

            {% for flashMessage in app.flashes('error') %}
                <div class="password-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>{{ flashMessage }}</span>
                </div>
            {% endfor %}

            <button type="submit" class="password-button">
                <i class="fa-solid fa-key"></i>
                Zmień hasło
            </button>

            {{ form_end(changePasswordForm) }}

            <div class="password-footer">
                <a href="{{ path('homepage') }}">
                    <i class="fa-solid fa-arrow-left"></i>
                    Wróć do strony głównej
                </a>
            </div>

        </div>

    </section>
{% endblock %}
