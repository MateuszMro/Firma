
{% extends 'pages/home.html.twig' %}

{% block title %}Reset hasła{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/reset-password.css') }}">
{% endblock %}

{% block content %}

    <section class="reset-wrapper">

        <div class="reset-container">

            <div class="reset-card">

                <div class="reset-icon">
                    <span>GM</span>
                </div>

                <h1>Resetuj hasło</h1>

                <p class="reset-subtitle">
                    Nie pamiętasz hasła? Pomożemy Ci odzyskać dostęp do konta.
                    Podaj adres e-mail oraz login przypisany do konta.
                </p>

                {{ form_start(resetPasswordForm, {
                    'attr': {'class': 'reset-form'}
                }) }}

                <div class="reset-field">
                    {{ form_row(resetPasswordForm.email, {
                        'attr': {
                            'autofocus': true,
                            'placeholder': 'example@gmail.com',
                            'class': 'reset-input'
                        },
                        'label': 'Adres e-mail'
                    }) }}
                </div>

                <div class="reset-field">
                    {{ form_row(resetPasswordForm.login, {
                        'attr': {
                            'placeholder': 'Twój login',
                            'class': 'reset-input'
                        },
                        'label': 'Login'
                    }) }}
                </div>

                {% for flashMessage in app.flashes('error') %}
                    <div class="reset-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>{{ flashMessage }}</span>
                    </div>
                {% endfor %}

                {{ form_errors(resetPasswordForm) }}

                <button type="submit" class="reset-button">
                    <i class="fa-solid fa-key"></i>
                    Resetuj hasło
                </button>

                {{ form_end(resetPasswordForm) }}

                <div class="reset-footer">
                    Pamiętasz hasło?
                    <a href="{{ path('app_login') }}">Zaloguj się</a>
                </div>

            </div>

        </div>

    </section>

{% endblock %}
